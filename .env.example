# Node.js 24. npm start reads .env automatically.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Optional: 12+ character administrator password.
# If empty, a random password is saved to data/admin-password.txt on first start.
ADMIN_PASSWORD=
# Set this to the exact browser origin when deployed, e.g. https://reset.example.com
APP_URL=
# false for local HTTP; true for HTTPS production
SECURE_COOKIE=false
# 0 for direct access; 1 only when behind one trusted reverse proxy
TRUST_PROXY=0
# IPv4 avoids unreliable IPv6 routes on some hosts
NETWORK_FAMILY=4
# Optional outbound proxy, supported by Node's --use-env-proxy flag:
# HTTPS_PROXY=http://127.0.0.1:7890
